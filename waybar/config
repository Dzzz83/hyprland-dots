{
    "modules-left": ["custom/power", "ext/workspaces"],
    // "modules-center": [],
    "modules-right": ["tray", "custom/network", "custom/battery", "pulseaudio", "clock"],

    "custom/power": {
        "exec": "python3 $HOME/.config/hypr/scripts/waybar-power-mode.py",
        "return-type": "json",
        "format": "{} ",
        "restart-interval": 5,
        "exec-on-event": false,
        "tooltip": true,
        "on-click": "wlogout -b 5",
    },

    "ext/workspaces": {
        "format": "{name}",
        "on-click": "activate",
        "sort-by-id": true
    },

    "tray": {
        "icon-size": 20,
        "spacing": 10,
        "cursor": true,
    },

    "bluetooth": {
        "format": " 󰂯 ",
        "format-disabled": " 󰂲 ",
        "format-connected": " 󰂱 ",
        "on-click": "$HOME/.local/bin/wifi-manager --toggle",
    },

    "custom/network": {
        "exec": "python3 $HOME/.config/hypr/scripts/waybar-network.py",
        "return-type": "json",
        "format": "{}",
        "restart-interval": 5,
        "exec-on-event": false,
        "on-click": "$HOME/.local/bin/wifi-manager --toggle",
        "tooltip": true,
    },

    "custom/battery": {
        "exec": "python3 -B $HOME/.config/hypr/scripts/waybar-battery.py",
        "return-type": "json",
        "format": "{}",
        "restart-interval": 5,
        "exec-on-event": false,
        "tooltip": true,
        "on-click": "python3 -B $HOME/.config/hypr/scripts/battery-panel.py --toggle",
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "  {volume}%",
        "format-bluetooth": " {volume}%",
        "format-bluetooth-muted": "  {volume}%",
        "format-icons": {
            "headphone": " ",
            "headset": " ",
            "default": [" "],
        },
        "on-click": "$HOME/.local/bin/audio-panel --toggle",
    },

    "clock": {
        "format": "{:%a %d/%m/%Y ~ %H:%M}",
        "tooltip-format": "<span size='15000'><tt>{calendar}</tt></span>",
        "calendar": {
            "mode": "month",
            "format": {
                "months": "<span color='#F5C2E7'><b>{}</b></span>",
                "weekdays": "<span color='#89B4FA'><b>{}</b></span>",
                "days": "<span color='#CDD6F4'><b>{}</b></span>",
                "today": "<span color='#F9E2AF'><b>{}</b></span>",
            }
        },
        "on-click": "swaync-client -t -sw",
    }
}
