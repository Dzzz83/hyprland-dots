configuration {
    show-icons: true;
    icon-theme: "WhiteSur-dark";
}

* {
    font-family: "JetBrainsMono Nerd Font";
    background-color: transparent;
    text-color: #cdd6f4;
}

window {
    width: 350px;
    border-radius: 16px;
    background-color: #1e1e2e;
    border: 2px;
    border-color: #313244;
    padding: 16px;
}

entry {
    placeholder: "Search Wi-Fi...";
    background-color: #313244;
    text-color: #cdd6f4;
    padding: 12px;
    border-radius: 10px;
    margin-bottom: 12px;
}

listview {
    lines: 6;
    fixed-height: false;
    scrollbar: false;
}

element {
    padding: 10px;
    border-radius: 8px;
    background-color: transparent;
}

element selected {
    background-color: #89b4fa;
    text-color: #1e1e2e;
}

element-icon {
    size: 24px;
    margin-right: 12px;
}

element-text {
    vertical-align: 0.5;
}